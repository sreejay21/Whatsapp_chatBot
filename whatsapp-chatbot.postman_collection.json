{
	"info": {
		"_postman_id": "whatsapp-chatbot-collection",
		"name": "WhatsApp Chatbot API",
		"description": "Collection for WhatsApp Chatbot API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Webhook",
			"item": [
				{
					"name": "Verify Webhook",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/webhook?hub.mode=subscribe&hub.challenge=1234&hub.verify_token={{verifyToken}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhook"
							],
							"query": [
								{
									"key": "hub.mode",
									"value": "subscribe"
								},
								{
									"key": "hub.challenge",
									"value": "1234"
								},
								{
									"key": "hub.verify_token",
									"value": "{{verifyToken}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Handle Webhook",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"object\": \"whatsapp_business_account\",\n    \"entry\": [\n        {\n            \"id\": \"12345\",\n            \"changes\": [\n                {\n                    \"value\": {\n                        \"messaging_product\": \"whatsapp\",\n                        \"metadata\": {\n                            \"display_phone_number\": \"123456789\",\n                            \"phone_number_id\": \"12345\"\n                        },\n                        \"contacts\": [\n                            {\n                                \"profile\": {\n                                    \"name\": \"John Doe\"\n                                },\n                                \"wa_id\": \"1234567890\"\n                            }\n                        ],\n                        \"messages\": [\n                            {\n                                \"from\": \"1234567890\",\n                                \"id\": \"wamid.HBgLMTIzNDU2Nzg5MFUVMzBGRDM2RTBDRDRCM0E3N0IAA=\",\n                                \"timestamp\": \"1623054123\",\n                                \"text\": {\n                                    \"body\": \"hi\"\n                                },\n                                \"type\": \"text\"\n                            }\n                        ]\n                    },\n                    \"field\": \"messages\"\n                }\n            ]\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/webhook",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhook"
							]
						}
					},
					"response": []
				}
			]
		},
